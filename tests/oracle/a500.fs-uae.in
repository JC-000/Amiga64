# tests/oracle/a500.fs-uae.in — FS-UAE config for one AROS oracle run
# (tests/aros_oracle.py fills the {placeholders}).  A500, 68000, the pinned
# AROS ROM banks from the cache (tools/aros/fetch.sh), 1 MB chip + 512 KB
# slow + 8 MB Zorro II fast (the most a 68000 A500 takes), no floppy, the
# run's host directory as the bootable DH0:, no window, no sound, warp.
[fs-uae]
amiga_model = A500
kickstart_file = {rom}
kickstart_ext_file = {ext}
chip_memory = 1024
slow_memory = 512
fast_memory = 8192
hard_drive_0 = {hd}
hard_drive_0_label = DH0
headless = 1
sound = 0
warp_mode = 1
automatic_input_grab = 0
initial_input_grab = 0
base_dir = {base}
